APP_NAME="VendeFácil"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vendefacil.kesug.com

SEO_SITE_NAME="VendeFácil"
SEO_TITLE="VendeFácil | Marketplace de negocios locales en Perú"
SEO_DESCRIPTION="Descubre negocios locales, encuentra productos únicos y compra directamente por WhatsApp en VendeFácil."
SEO_IMAGE="images/seo/vendefacil-home.png"
SEO_LOCALE=es_PE
SEO_COUNTRY=PE

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
