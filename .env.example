# Plantilla unica. Copiala a .env solo para una instalacion nueva.
# No reemplaces un .env existente ni publiques sus claves.
APP_NAME="VendeFácil"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

SEO_SITE_NAME="VendeFácil"
SEO_TITLE="VendeFácil | Marketplace de negocios locales en Perú"
SEO_DESCRIPTION="Descubre negocios locales, encuentra productos únicos y compra directamente por WhatsApp en VendeFácil."
SEO_IMAGE="images/seo/vendefacil-home.png"
SEO_LOCALE=es_PE
SEO_COUNTRY=PE

VENDEFACIL_FREE_PRODUCT_LIMIT=10
VENDEFACIL_UNLIMITED_PRODUCTS_PRICE=15.00
VENDEFACIL_PAYMENT_NUMBER=989652889
VENDEFACIL_PAYMENT_WHATSAPP=51989652889
VENDEFACIL_FEATURED_DAYS=30
VENDEFACIL_SUPPORT_WHATSAPP=51989652889
# Correo de contacto publico opcional, distinto de las credenciales SMTP.
VENDEFACIL_SUPPORT_EMAIL=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=single
LOG_LEVEL=error

# SQLite para empezar; para MySQL cambia DB_CONNECTION y completa sus datos.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vendefacil
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# log no envia correo. Para Gmail cambia a smtp y usa una clave de aplicacion.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_KEEP_DAYS=14
BACKUP_TIME=03:00
BACKUP_TIMEZONE=America/Lima
# Solo si mysql/mysqldump no estan en PATH ni en C:/xampp/mysql/bin:
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# MYSQL_PATH=/usr/bin/mysql

# En produccion: APP_ENV=production, APP_URL=https://tu-dominio,
# SESSION_SECURE_COOKIE=true. APP_DEBUG debe seguir en false.
VITE_APP_NAME="${APP_NAME}"
